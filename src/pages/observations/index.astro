---
import Base from '../../layouts/Base.astro';
import { list, u, fmt } from '../../lib';
const items = await list('observations');
// 每座城市記了幾則
const tally = new Map<string, number>();
for (const e of items) {
  const k = e.data.city ?? '其他';
  tally.set(k, (tally.get(k) ?? 0) + 1);
}
const cities = [...tally].sort((a, b) => b[1] - a[1]);
---
<Base title="觀察" active="observations" crumb={`觀察 / OBSERVATIONS · ${cities.length} PLACES · ${items.length} ENTRIES`}>
  <div class="sheet-title"><h2>走過的地方</h2><span class="meta">在城市裡看到、想到的</span></div>
  {cities.length > 0 && (
    <ul class="places" aria-label="各城市的觀察數">
      {cities.map(([name, n]) => <li><b>{name}</b><span>{n}</span></li>)}
    </ul>
  )}
  {items.length === 0 ? (
    <div class="empty-state"><b>這裡還沒有觀察</b>寫下第一則之後，它就會出現在這裡。</div>
  ) : (
    <div class="rows">
      {items.map((e) => (
        <a class="row" href={u(`observations/${e.id}/`)}>
          <div><b>{e.data.title}</b><span>{[e.data.city, e.data.street].filter(Boolean).join(' · ')}</span></div>
          <span class="d">{fmt(e.data.date)}</span>
        </a>
      ))}
    </div>
  )}
</Base>
